{
    "name": "packfuse",
    "version": "1.1.0",
    "description": "Fuse skill packs onto Cursor, Claude Code, and Codex",
    "type": "module",
    "bin": {
        "packfuse": "./dist/cli.js"
    },
    "files": [
        "dist",
        "packs",
        "templates"
    ],
    "scripts": {
        "build": "tsc",
        "packfuse": "tsx src/cli.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test src/snapshot.test.ts src/evals.test.ts",
        "validate": "node --import tsx src/validate.ts",
        "eval": "node evals/run.mjs"
    },
    "engines": {
        "node": ">=20.6"
    },
    "keywords": [
        "cursor",
        "claude",
        "codex",
        "skills",
        "agent"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/benoky/packfuse.git"
    },
    "homepage": "https://www.npmjs.com/package/packfuse",
    "bugs": {
        "url": "https://github.com/benoky/packfuse/issues"
    },
    "dependencies": {
        "commander": "^13.1.0",
        "js-tiktoken": "^1.0.21",
        "yaml": "^2.8.1"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2"
    }
}
