{
    "name": "packfuse",
    "version": "1.2.0",
    "description": "Install reusable coding skills and rules for Cursor, Claude Code, and Codex.",
    "type": "module",
    "bin": {
        "packfuse": "./dist/cli.js"
    },
    "files": [
        "dist",
        "packs",
        "templates"
    ],
    "scripts": {
        "build": "tsc",
        "prepack": "npm run build",
        "packfuse": "tsx src/cli.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test src/snapshot.test.ts src/evals.test.ts src/codex-plugin.test.ts",
        "pack:codex": "tsx scripts/pack-codex-plugin.ts",
        "validate": "node --import tsx src/validate.ts",
        "eval": "node evals/run.mjs",
        "downloads": "node scripts/npm-downloads.mjs"
    },
    "engines": {
        "node": ">=20.6"
    },
    "keywords": [
        "cursor",
        "claude-code",
        "claude",
        "codex",
        "agent-skills",
        "skills",
        "developer-tools",
        "coding-agent"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/benoky/packfuse.git"
    },
    "homepage": "https://github.com/benoky/packfuse#readme",
    "bugs": {
        "url": "https://github.com/benoky/packfuse/issues"
    },
    "dependencies": {
        "commander": "^13.1.0",
        "yaml": "^2.8.1"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2"
    }
}
